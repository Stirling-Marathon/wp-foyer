<?xml version="1.0" encoding="utf-8"?>
<component name="SignagePlayer" extends="Group">
  <interface>
    <field id="displaySlug" type="string" />
    <field id="displayName" type="string" />
    <field id="apiBaseUrl" type="string" />
    <field id="settingsRequested" type="boolean" alwaysNotify="true" />
    <field id="refreshRequested" type="boolean" alwaysNotify="true" />
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
    <field id="diagnostics" type="assocarray" />
    <function name="StartPlayer" />
    <function name="RefreshNow" />
    <function name="ResetPlayer" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="#020617" />
    <Poster id="currentPoster" width="1920" height="1080" opacity="0" />
    <Poster id="nextPoster" width="1920" height="1080" opacity="0" />
    <Group id="statusGroup" visible="true">
      <Label id="statusTitle" text="WordPress Foyer" translation="[110,110]" width="1600" height="70" font="font:LargeBoldSystemFont" color="#f8fafc" />
      <Label id="statusText" translation="[110,200]" width="1600" height="120" wrap="true" font="font:MediumSystemFont" color="#cbd5e1" />
    </Group>
    <Timer id="slideTimer" repeat="false" />
    <Timer id="refreshTimer" repeat="true" />
    <Animation id="fadeAnimation" duration="1" easeFunction="linear">
      <FloatFieldInterpolator id="fadeIn" key="[0,1]" keyValue="[0,1]" />
      <FloatFieldInterpolator id="fadeOut" key="[0,1]" keyValue="[1,0]" />
    </Animation>
  </children>
  <script type="text/brightscript" uri="pkg:/source/AppConfig.generated.brs" />
  <script type="text/brightscript" uri="pkg:/components/AppConfig.brs" />
  <script type="text/brightscript" uri="pkg:/components/RokuUtils.brs" />
  <script type="text/brightscript" uri="pkg:/components/ManifestNormalizer.brs" />
  <script type="text/brightscript" uri="pkg:/components/SignagePlayer.brs" />
</component>
